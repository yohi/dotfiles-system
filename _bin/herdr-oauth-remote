#!/usr/bin/env bash
# Run from Ubuntu Desktop, not the remote server.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: herdr-oauth-remote --port PORT [--session NAME] SSH_ALIAS

Start a loopback-only SSH OAuth callback tunnel, then herdr --remote.
Open the OAuth link from the remote pane with Ctrl-click.
Use device-code sign-in instead whenever the agent supports it.
EOF
}
die() { printf 'herdr-oauth-remote: %s\n' "$*" >&2; exit 2; }
port="" session="" target=""
while (($#)); do
  case "$1" in
    --port|--session)
      (($# >= 2)) || die "$1 needs an argument"
      if [[ "$1" == --port ]]; then port="$2"; else session="$2"; fi
      shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z "$target" ]] || die "expected exactly one SSH alias"
       target="$1"; shift ;;
  esac
done
[[ "$target" =~ ^[a-zA-Z0-9._@-]+$ && "$target" != -* ]] ||
  die "provide an SSH config alias or user@host (not ssh:// or options)"
[[ "$port" =~ ^[0-9]{1,5}$ ]] || die "port must be 1-65535"
number=$((10#$port))
((number >= 1 && number <= 65535)) || die "port must be 1-65535"
port="$number"
[[ -z "$session" || "$session" != -* ]] || die "invalid session"
command -v ssh >/dev/null || die "ssh is required"
command -v herdr >/dev/null || die "herdr is required"

umask 077
temp_base="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
[[ -d "$temp_base" && -w "$temp_base" ]] || die "temp directory unavailable"
temp_dir="$(mktemp -d "$temp_base/herdr-oauth.XXXXXXXX")"
socket="$temp_dir/control.sock"
started=0
cleanup() {
  if [[ "$started" == 1 ]]; then
    ssh -S "$socket" -O exit -- "$target" >/dev/null 2>&1 ||
      printf 'Warning: failed to confirm SSH tunnel shutdown\n' >&2
  fi
  rm -f -- "$socket"
  rmdir -- "$temp_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if ! ssh -M -S "$socket" -fN -o ExitOnForwardFailure=yes \
    -o ForwardAgent=no -L "127.0.0.1:$port:127.0.0.1:$port" -- "$target"; then
  die "could not establish localhost tunnel to $target on port $port"
fi
started=1
printf 'OAuth localhost tunnel active on Desktop port %s for %s\n' "$port" "$target"
printf 'Ctrl-click the OAuth link in Herdr to open the Desktop browser.\n'
args=(--remote "$target")
[[ -z "$session" ]] || args+=(--session "$session")
herdr "${args[@]}"
